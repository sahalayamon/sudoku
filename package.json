{
  "name": "sudoku",
  "version": "1.0.0",
  "private": true,
  "description": "A calm, premium Sudoku for web and mobile.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "serve": "node scripts/serve-out.mjs",
    "start": "node scripts/serve-out.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "edge:sync": "node scripts/sync-edge-engine.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"*.{mjs,ts,json}\"",
    "test:db": "vitest run tests/database.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "themes": "node scripts/generate-themes.mjs && prettier --write src/app/globals.css",
    "worker": "node scripts/build-worker.mjs",
    "predev": "node scripts/build-worker.mjs",
    "prebuild": "node scripts/build-worker.mjs",
    "android": "node scripts/android.mjs debug",
    "android:release": "node scripts/android.mjs release",
    "android:bundle": "node scripts/android.mjs bundle",
    "android:open": "node scripts/android.mjs open",
    "android:sync": "node scripts/android.mjs sync"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource-variable/geist": "^5.2.0",
    "@fontsource-variable/geist-mono": "^5.2.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/instrument-serif": "^5.2.0",
    "@supabase/supabase-js": "^2.100.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "lucide-react": "^1.52.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.30.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.9",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
